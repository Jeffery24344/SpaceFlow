<Window x:Class="SpaceFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceFlow — More Room When You Need It"
        Height="780" Width="960"
        MinHeight="640" MinWidth="800"
        Background="{StaticResource BgPrimary}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="SpaceFlow" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
        <TextBlock Text="  •  More Room When You Need It" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
        <TextBlock x:Name="StatusText" Text="IDLE" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,0,0,14">
      <Border Background="{StaticResource BgCard}" CornerRadius="12" Margin="0,0,8,8" Padding="18">
        <StackPanel>
          <TextBlock Text="PHYSICAL RAM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
          <TextBlock x:Name="RamValueText" Text="— / —" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
          <ProgressBar x:Name="RamBar" Height="7" Margin="0,10,0,0" Minimum="0" Maximum="100" Background="#2D3340" Foreground="{StaticResource Accent}"/>
          <TextBlock x:Name="RamPercentText" Text="0%" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource BgCard}" CornerRadius="12" Margin="8,0,0,8" Padding="18">
        <StackPanel>
          <TextBlock Text="MEMORY PRESSURE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
          <TextBlock x:Name="PressureText" Text="NORMAL" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Success}"/>
          <TextBlock x:Name="CpuText" Text="CPU: —%" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
          <TextBlock x:Name="HealthText" Text="Health: —" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource BgCard}" CornerRadius="12" Margin="0,8,8,0" Padding="18">
        <StackPanel>
          <TextBlock Text="TEMPORARY WORKSPACE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
          <TextBlock x:Name="WorkspaceValueText" Text="0 / 0 GB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
          <ProgressBar x:Name="WorkspaceBar" Height="7" Margin="0,10,0,0" Minimum="0" Maximum="100" Background="#2D3340" Foreground="{StaticResource Accent}"/>
          <TextBlock x:Name="WorkspaceStatusText" Text="Inactive" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource BgCard}" CornerRadius="12" Margin="8,8,0,0" Padding="18">
        <StackPanel>
          <TextBlock Text="MODE & STORAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
          <TextBlock x:Name="ModeText" Text="LOCAL" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
          <TextBlock x:Name="DiskText" Text="Drive: —  •  Free: —" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
          <TextBlock x:Name="StorageTypeText" Text="Type: —" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </UniformGrid>
    <Border Grid.Row="2" Background="{StaticResource BgSecondary}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="ACTIVE WORKLOAD (Top memory consumers)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
          <ListView x:Name="ProcessList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" FontSize="12" MaxHeight="160">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Process" Width="180" DisplayMemberBinding="{Binding ProcessName}"/>
                <GridViewColumn Header="Memory" Width="90" DisplayMemberBinding="{Binding DisplayMemory}"/>
                <GridViewColumn Header="Preference" Width="100" DisplayMemberBinding="{Binding Preference}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
          <Button Content="Prioritize selected" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="BtnPrioritize_Click"/>
          <Button Content="Ignore selected" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="BtnIgnore_Click"/>
          <Button Content="Reset to Automatic" Style="{StaticResource SecondaryButton}" Click="BtnResetPref_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="{StaticResource BgCard}" CornerRadius="12" Padding="16">
      <StackPanel>
        <TextBlock Text="CONTROLS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
        <WrapPanel>
          <Button x:Name="BtnStart" Content="Start SpaceFlow" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="BtnStart_Click"/>
          <Button x:Name="BtnStop" Content="Stop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="BtnStop_Click" IsEnabled="False"/>
          <Button x:Name="BtnLocal" Content="Local Flow" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="BtnLocal_Click"/>
        </WrapPanel>
        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                   Text="SpaceFlow never creates physical RAM. Temporary workspace uses local storage and is released when no longer needed."/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="4" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource TextSecondary}"
               Text="SpaceFlow v0.2 Smart Local Flow  •  Safety first  •  Only SpaceFlow-created temporary data is cleaned"/>
  </Grid>
</Window>
